<?xml version="1.0" encoding="utf-8"?>
<!-- The SCAR-H's own copy of Guns of Marz's LoadFAL_HB.xml (its fal_rifle node), under the SCAR-H's own WeaponReloadType so that no other mod's LoadFAL_HB.xml can replace it: old copies of that file (Guns of Marz before its 2026-10-23 update, Marz Mods Animsets for Linux) answer "FAL" and override GoM's by load order. -->
<animNode>
	<m_Name>LoadGunsOfTienSCARH</m_Name>
	<m_AnimName>Ithaca_Reload_FAL_Load</m_AnimName>
	<m_Looped>false</m_Looped>
	<m_BlendTime>0.20</m_BlendTime>
	<m_EarlyTransitionOut>true</m_EarlyTransitionOut>
	<m_SpeedScale>ReloadSpeed</m_SpeedScale>
	<m_SyncTrackingEnabled>false</m_SyncTrackingEnabled>
	<m_ConditionPriority>10</m_ConditionPriority>
	<m_Conditions>
		<m_Name>PerformingAction</m_Name>
		<m_Type>STRING</m_Type>
		<m_StringValue>Reload</m_StringValue>
	</m_Conditions>
	<m_Conditions>
		<m_Name>WeaponReloadType</m_Name>
		<m_Type>STRING</m_Type>
		<m_StringValue>GunsOfTienSCARH</m_StringValue>
	</m_Conditions>
	<m_Conditions>
		<m_Name>isLoading</m_Name>
		<m_Type>BOOL</m_Type>
		<m_BoolValue>true</m_BoolValue>
	</m_Conditions>
	<m_Events>
		<m_EventName>loadFinished</m_EventName>
		<m_Time>End</m_Time>
		<m_ParameterValue></m_ParameterValue>
	</m_Events>
	<m_Events>
		<m_EventName>playReloadSound</m_EventName>
		<m_TimePc>0.3</m_TimePc>
		<m_ParameterValue>load</m_ParameterValue>
	</m_Events>
	<m_Events>
		<m_EventName>playReloadSound</m_EventName>
		<m_Time>Start</m_Time>
		<m_ParameterValue>insertAmmoStart</m_ParameterValue>
	</m_Events>
	<m_Events>
		<m_EventName>InsertMag</m_EventName>
		<m_TimePc>0.85</m_TimePc>
	</m_Events>
</animNode>
